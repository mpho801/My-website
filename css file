/* ===========================
   BLOOMSOFT SKINCARE WEBSITE
   =========================== */

/* 1. Global Reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* 2. Body & Typography */
body {
  font-family: Arial, sans-serif;
  background-color: #fdfdfd; /* Soft Beige */
  color: #333; /* Neutral text */
  line-height: 1.6;
}

/* 3. Header */
header {
  background: #88c999; /* Leaf Green */
  color: white;
  text-align: center;
  padding: 30px 20px;
}

header h1 {
  font-size: 2.2rem;
  margin-bottom: 10px;
}

/* 4. Navigation */
nav {
  background: #444; /* Deep Forest */
  text-align: center;
  padding: 10px;
}

nav ul {
  list-style: none;
}

nav ul li {
  display: inline-block;
  margin: 0 15px;
}

nav ul li a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}

nav ul li a:hover {
  color: #88c999;
}

/* 5. Sections */
section {
  padding: 40px;
  max-width: 900px;
  margin: auto;
}

section h2 {
  color: #88c999;
  margin-bottom: 15px;
}

/* 6. Images */
section img {
  width: 100%;
  max-height: 300px;
  object-fit: cover;
  margin: 20px 0;
  border-radius: 8px;
}

/* 7. Forms (Enquiry Page) */
form {
  display: flex;
  flex-direction: column;
}

form label {
  margin-top: 10px;
  font-weight: bold;
}

form input, form textarea {
  padding: 10px;
  margin-top: 5px;
  border: 1px solid #ccc;
  border-radius: 5px;
}

form button {
  margin-top: 15px;
  padding: 12px;
  background: #88c999;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

form button:hover {
  background: #66a777;
}

/* 8. Footer */
footer {
  background: #444;
  color: white;
  text-align: center;
  padding: 15px;
  margin-top: 20px;
}
